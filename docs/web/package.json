{
  "name": "glowup-docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "react-router dev",
    "postinstall": "fumadocs-mdx",
    "test": "node --test \"test/*.spec.ts\"",
    "build": "react-router build && node scripts/flatten.ts && node scripts/copy-assets.ts && node scripts/crawl.ts",
    "preview": "node scripts/preview.ts",
    "check": "fumadocs-mdx && react-router typegen && tsc && node scripts/check-links.ts"
  },
  "dependencies": {
    "@types/mdx": "^2.0.14",
    "fumadocs-core": "^16.16.1",
    "fumadocs-mdx": "^15.4.6",
    "fumadocs-ui": "^16.16.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "isbot": "^5"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "mdast-util-from-markdown": "^2.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.3.2",
    "yaml": "^2.9.1"
  }
}
